{
  "name": "altiora-backend",
  "version": "1.0.0",
  "description": "Backend service for Altiora trading journal - MetaTrader account synchronization",
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "db:generate": "drizzle-kit generate:pg",
    "db:migrate": "drizzle-kit migrate:pg",
    "db:push": "drizzle-kit push:pg",
    "db:setup": "tsx setup-db.js",
    "db:studio": "drizzle-kit studio",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts"
  },
  "dependencies": {
    "@paralleldrive/cuid2": "^2.3.1",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.45.1",
    "express": "^4.22.1",
    "express-rate-limit": "^7.5.1",
    "helmet": "^7.2.0",
    "metaapi.cloud-sdk": "^29.3.2",
    "pg": "^8.16.3",
    "postgres": "^3.4.7",
    "winston": "^3.19.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/express-rate-limit": "^6.0.2",
    "@types/node": "^20.19.27",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "drizzle-kit": "^0.31.8",
    "eslint": "^8.57.1",
    "prettier": "^3.7.4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "trading",
    "metatrader",
    "journal",
    "api",
    "backend"
  ],
  "author": "Altiora Team",
  "license": "MIT"
}
