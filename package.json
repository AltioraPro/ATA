{
  "name": "altiora-backend",
  "version": "1.0.0",
  "description": "Backend service for Altiora trading journal - MetaTrader account synchronization",
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "db:generate": "drizzle-kit generate:pg",
    "db:migrate": "drizzle-kit migrate:pg",
    "db:push": "drizzle-kit push:pg",
    "db:setup": "tsx setup-db.js",
    "db:studio": "drizzle-kit studio",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts"
  },
  "dependencies": {
    "@paralleldrive/cuid2": "^2.2.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "drizzle-orm": "^0.30.10",
    "express": "^4.18.2",
    "metaapi.cloud-sdk": "^29.3.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "postgres": "^3.4.4",
    "winston": "^3.11.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-rate-limit": "^6.0.0",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "drizzle-kit": "^0.20.14",
    "eslint": "^8.56.0",
    "prettier": "^3.1.1",
    "tsx": "^4.6.2",
    "typescript": "^5.3.3"
  },
  "keywords": [
    "trading",
    "metatrader",
    "journal",
    "api",
    "backend"
  ],
  "author": "Altiora Team",
  "license": "MIT"
}
